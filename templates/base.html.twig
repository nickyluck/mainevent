<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		<title>
			{% block title %}Main Event du VHEP
			{% endblock %}
		</title>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
		<link rel="stylesheet" href="{{ asset('mainevent2022.css') }}">
		<link rel="icon" type="image/png" href="{{ asset('img/jeton.png') }}"/>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa" crossorigin="anonymous" defer></script>
	</head>

	<body class="container">
		<header>
			<img class="rounded" src="img/banniere.png" alt="Logo du VHEP">

			<div class="title text-center">13<sup>e</sup>
				Main Event du VHEP</div>
		</header>


		<nav class="navbar navbar-expand-lg navbar-dark bg-secondary rounded">
			<div class="container-fluid">
				<a class="btn btn-inscription d-lg-none" href="{{ path('inscription') }}">S'inscrire</a>
				<button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="Ouvrir le menu">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbar">
					<ul class="navbar-nav me-auto mb-2 mb-lg-0">
						<li class="nav-item">
							<a class="nav-link{{ (active == 'home') ? ' active' }}" href="{{ path('home') }}">Accueil</a>
						</li>
						<li class="nav-item d-none d-lg-block">
							<a class="nav-link{{ (active == 'inscription') ? ' active' }}" href="{{ path('inscription') }}">Inscription</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{{ (active == 'structure') ? ' active' }}" href="{{ path('structure') }}" href="#">Structure</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{{ (active == 'dotation') ? ' active' }}" href="{{ path('dotation') }}" href="#">Dotation</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{{ (active == 'side') ? ' active' }}" href="{{ path('side') }}" href="#">Side Event</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{{ (active == 'infos') ? ' active' }}" href="{{ path('infos') }}" href="#">Infos Pratiques</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{{ (active == 'liste') ? ' active' }}" href="{{ path('liste') }}" href="#">Liste des inscrits</a>
						</li>
						<li class="nav-item">
							<a class="nav-link{{ (active == 'classement') ? ' active' }}" href="{{ path('classement') }}" href="#">Classement</a>
							{# <a class="nav-link disabled{{ (active == 'classement') ? ' active' }}" href="{{ path('classement') }}" href="#">Classement</a> #}
						</li>
					</ul>
				</div>
			</div>
		</nav>

		{% for label, messages in app.flashes(['success', 'warning']) %}
			{% for message in messages %}
				<div class="alert alert-{{ label }}">
					{{ message }}
				</div>
			{% endfor %}
		{% endfor %}

		<main class="rounded bg-secondary"> {% block body %}{% endblock %}

			<footer>
				<div class="text-center">
					Le Vesoul Hold'Em Poker remercie tous ses partenaires :
				</div>
				<div class="partenaires">
					<img src="img/LogoCdC.png" alt="Club des clubs" height="80">
					<img
					src="img/fontaine-aux-vins.png" alt="La Fontaine aux Vins" height="80" width="100">
					{# <img src="img/renov'eco.jpg" alt="Renov'eco" height="80"> #}
					<img src="img/winamax.jpg" alt="Winamax" height="80" width="100">
					<img src="img/ville de vesoul.png" alt="Ville de Vesoul" height="80" width="70">
				</div>
			</footer>
		</main>
	</body>
</html>
